            "url": { "raw": "{{baseUrl}}/api/analytics/segments?k=4", "host": ["{{baseUrl}}"], "path": ["api", "analytics", "segments"] }
          }
        },
        {
          "name": "Get Sentiment Analysis",
          "request": {
            "method": "GET",
