# ═══════════════════════════════════════════════════════
#  Company Management System – Environment Configuration
#  Copy this file to .env and update values for production
# ═══════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me_in_production
DB_HOST=postgres
DB_PORT=5432
DB_NAME=cms_db
DB_USER=cms_app
DB_PASSWORD=change_me_in_production
DB_SSLMODE=disable

# ── Data Warehouse User ──────────────────────────────
DW_USER=dw_user
DW_PASSWORD=change_me_in_production

# ── JWT Security ─────────────────────────────────────
# MUST be ≥ 32 bytes (64 hex chars). Generate with:
#   openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ── Internal API Bridge (Backend ↔ Analytics) ────────
INTERNAL_API_KEY=change_me_in_production

# ── Application ──────────────────────────────────────
APP_PORT=80
